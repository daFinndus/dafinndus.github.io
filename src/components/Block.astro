---
const { content, language } = Astro.props;
---

<style>
.prose code {
  font-family: "JetBrains Mono NF", "JetBrains Mono", monospace;
  color: var(--text);
}

.code-block pre {
  font-family: "JetBrains Mono NF", "JetBrains Mono", monospace;
}

.code-block-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: -12px;
}

.copy-code {
  padding: 0.35rem 0.65rem;
  cursor: pointer;
}

.copy-code {
  background: none;
  border: none;
  color: var(--text-ink);
  font: 0.75rem "JetBrains Mono";
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
</style>

<div class="code-block">
  <div class="code-block-header">
      <div class="meta">{language}</div><button class="copy-code" type="button" data-copy-code>Copy</button>
  </div>
  <pre><code>{content}</code></pre>
</div>

<script>
  // Copy content of data-copy-code to clipboard
  document.querySelectorAll<HTMLButtonElement>("[data-copy-code]").forEach((button) => {
    button.addEventListener("click", async () => {
      const code = button.closest(".code-block")?.querySelector("code")?.textContent;

      // No code found
      if (!code) return;

      // Write to clipboard
      await navigator.clipboard.writeText(code);
      const original = button.textContent;
      button.textContent = "Copied";
      setTimeout(() => { button.textContent = original; }, 1500);
    });
  });
</script>
