---
import Layout from "../layouts/Layout.astro";
import { education, experience } from "../data/cv";
---

<Layout title="CV">
  <div class="container">
    <section class="section"><div class="eyebrow">Education</div><h2>Learning the foundations.</h2><div class="timeline">{education.map((item) => <article class="timeline-item"><div class="meta">{item.period}</div><h3>{item.title}</h3><p><strong>{item.place}</strong></p><p>{item.detail}</p></article>)}</div></section>
    <section class="section"><div class="eyebrow">Experience</div><h2>Learning by doing.</h2><div class="timeline">{experience.map((item) => <article class="timeline-item"><div class="meta">{item.period}</div><h3>{item.title}</h3><p><strong>{item.place}</strong></p><p>{item.detail}</p></article>)}</div></section>
  </div>
</Layout>
