---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Clock">
  <div class="container clock-page"><div class="eyebrow">Local time</div><div class="clock" data-clock>--:--:--</div><a class="button" href="/">← Home</a></div>
  <script>
    const clock = document.querySelector("[data-clock]");
    const update = () => { if (clock) clock.textContent = new Intl.DateTimeFormat([], { hour: "2-digit", minute: "2-digit", second: "2-digit" }).format(new Date()); };
    update();
    setInterval(update, 1000);
  </script>
</Layout>
