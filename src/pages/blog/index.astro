---
import Layout from "../../layouts/Layout.astro";
import { writeups } from "../../data/writeups";

const sortedWriteups = [...writeups].sort((a, b) => b.date.localeCompare(a.date));
---

<Layout title="Writing">
  <div class="container">
    <header class="page-header"><div class="eyebrow">Field notes</div><h1>Writeups</h1><p>Security notes from machines, experiments, and the occasional rabbit hole. Open a writeup to read the full, focused page.</p></header>
    <div class="writeups" data-writeup-list>
      {sortedWriteups.map((writeup) => <article class="card writeup-card" data-writeup data-date={writeup.date} data-search-value={`${writeup.title} ${writeup.system} ${writeup.difficulty} ${writeup.keywords.join(" ")} ${writeup.description}`}>
        <img class="writeup-image" src={`https://s8lcpnzirhyz4bbt.public.blob.vercel-storage.com/Blogs/${writeup.slug}.png`} alt={`${writeup.title} machine`} loading="lazy" />
        <div class="writeup-content"><div class="meta">{writeup.system} · {writeup.difficulty} · {writeup.date}</div><h3>{writeup.title}</h3><p>{writeup.description}</p><div class="tags">{writeup.keywords.map((keyword) => <span class="tag">{keyword}</span>)}</div></div>
        <a class="button primary" href={`/blog/${writeup.slug}`}>Read writeup</a>
      </article>)}
    </div>
    <p class="lede" data-empty hidden>No writeups match those filters.</p>
  </div>
  <script>
    const root = document.querySelector<HTMLElement>("[data-writeup-filters]");
    const cards = [...document.querySelectorAll<HTMLElement>("[data-writeup]")];
    const empty = document.querySelector<HTMLElement>("[data-empty]");

    const update = () => {
      const query = root?.querySelector<HTMLInputElement>("[data-search]")?.value.toLowerCase() ?? "";
      let visible = 0;
      cards.forEach((card) => {
        const matches = card.dataset.searchValue?.toLowerCase().includes(query);
        card.toggleAttribute("hidden", !matches);
        if (matches) visible++;
      });
      if (empty) empty.toggleAttribute("hidden", visible !== 0);
    };

    root?.addEventListener("input", update);
    update();
  </script>
</Layout>
