---
import Layout from "../layouts/Layout.astro";

import { projects } from "../data/projects";

const sortedProjects = [...projects].sort((a, b) => b.date.getTime() - a.date.getTime());
---

<style>
.project-card {
  display: flex;
  flex-direction: column;
}

.project-image {
  display: block;
  width: 100%;
  height: 152px;
  aspect-ratio: 1;
  object-fit: cover;
  border-radius: 0.5rem;
  margin-bottom: 1rem;
}

project-card {
  min-width: 0;
}

.project-links .button {
  flex: 1;
}

.project-links {
  margin-top: auto;
  padding-top: 1rem;
}

.project-links .button {
  background: #222;
  color: #fff;
  border-color: #222;
  border-radius: 0.5rem;
}

.project-links .available {
  background: var(--accent);
  border-color: var(--accent);
}

.project-links .available:hover {
  background: var(--text);
  border-color: var(--text);
  color: var(--accent)
}

.project-links .unavailable {
  opacity: 0.45;
  cursor: not-allowed;
}
</style>

<Layout title="Projects">
  <div class="container">
    <div class="grid" data-project-list>
      {sortedProjects.map((project) => <article class="card project-card" data-project data-date={project.date.getTime()} data-search-value={`${project.name} ${project.description} ${project.skills.join(" ")} $${project.personal ? "personal" : ""} ${project.url ? "source github repository" : ""} ${project.demo ? "demo live" : ""} ${project.url ?? ""} ${project.demo ?? ""}`}>
        <img class="project-image" src={project.src} alt={project.alt} width={project.width} height={project.height} loading="lazy" />
        <div class="meta">{project.date.toLocaleDateString("en-CA")}</div><h3>{project.name}</h3><p>{project.description}</p>
        <div class="tags">{project.skills.map((skill) => <span class="tag">{skill}</span>)}</div>
        <div class="actions project-links">
          {project.url ? <a class="button available" href={project.url} target="_blank" rel="noreferrer">Source</a> : <span class="button unavailable" aria-disabled="true">Source</span>}
          {project.demo ? <a class="button available" href={project.demo} target="_blank" rel="noreferrer">Demo</a> : <span class="button unavailable" aria-disabled="true">Demo</span>}
        </div>
      </article>)}
    </div>
  </div>
</Layout>
