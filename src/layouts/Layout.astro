---
import "../styles/global.css";

const { title = "Finn Luca Jensen", description = "Portfolio of Finn Luca Jensen", showNav = true } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>Finn Luca Jensen</title>
  </head>
  <body>
    {showNav && <header class="site-header">
      <nav class="nav container" aria-label="Main navigation">
        <div class="nav-controls">
          <button class="nav-control" type="button" aria-label="Toggle color mode" data-theme-toggle>
            <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42" /></svg>
          </button>
          <a class="nav-control" href="/clock" aria-label="Open clock">
            <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
          </a>
          <a class="nav-control" href="/err" aria-label="Open error page">
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 3 2.8 19h18.4L12 3Z" /><path d="M12 9v4M12 16h.01" /></svg>
          </a>
        </div>
        <div class="nav-links">
          <a href="/" aria-current={currentPath === "/" ? "page" : undefined}>Home</a>
          <a href="/blog" aria-current={currentPath.startsWith("/blog") ? "page" : undefined}>Blog</a>
          <a href="/projects" aria-current={currentPath === "/projects" ? "page" : undefined}>Projects</a>
          <a href="/cv" aria-current={currentPath === "/cv" ? "page" : undefined}>CV</a>
        </div>
      </nav>
    </header>}
    <main><slot /></main>
    <script>
      const button = document.querySelector("[data-theme-toggle]");
      button?.addEventListener("click", () => {
        document.documentElement.classList.toggle("light");
      });
    </script>
  </body>
</html>
